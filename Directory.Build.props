<Project>
  <!--
    Assembly and repository identity. Nothing here is packed as a NuGet package —
    these are a web application and its supporting libraries — so the Package*
    properties are deliberately absent. The license is AGPL-3.0-only; see LICENSE.
  -->
  <PropertyGroup>
    <Product>TodoWerk</Product>
    <Description>Open-source tooling that adds missing capabilities to Microsoft To Do, starting with hashtag management.</Description>
    <Authors>CloudWerk GmbH</Authors>
    <Company>CloudWerk GmbH</Company>
    <Copyright>Copyright (c) 2026 CloudWerk GmbH</Copyright>
    <RepositoryUrl>https://github.com/Cloudwerk/todowerk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!--
    The version is the release tag, read by MinVer at build time: a commit tagged `v1.0.3` builds
    as 1.0.3, and a commit after it as a pre-release of the next patch (1.0.4-alpha.0.<height>),
    so nothing built after a release claims to be it. Nobody edits a number here. A build outside a
    git working tree, or from a clone without tags, falls back to 0.0.0-alpha.0. Releasing is
    `git tag v<version>` on main and pushing the tag; CI then rebuilds the image with it.
  -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisMode>All</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
</Project>
