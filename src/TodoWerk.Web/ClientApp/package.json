{
  "name": "todowerk-client",
  "version": "0.0.0",
  "description": "React and Fluent UI v9 single-page app for TodoWerk, served from the ASP.NET Core host.",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "CloudWerk GmbH",
  "homepage": "https://github.com/Cloudwerk/todowerk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cloudwerk/todowerk.git",
    "directory": "src/TodoWerk.Web/ClientApp"
  },
  "bugs": {
    "url": "https://github.com/Cloudwerk/todowerk/issues"
  },
  "keywords": [
    "microsoft-todo",
    "microsoft-graph",
    "hashtags",
    "fluentui",
    "react",
    "entra-id"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/verify-bundles.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "verify:bundles": "node scripts/verify-bundles.mjs"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.9",
    "@fluentui/react-icons": "^2.0.341",
    "@microsoft/teams-js": "^2.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
